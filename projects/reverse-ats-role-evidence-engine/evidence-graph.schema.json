{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.lauraelizabethhand.com/schema/role-evidence-node-v2.3.json",
  "title": "Role Evidence Engine Candidate Evidence Graph",
  "type": "object",
  "required": ["schema_version", "evidence_nodes"],
  "properties": {
    "schema_version": {"const": "2.3"},
    "generated_at": {"type": "string"},
    "evidence_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id","source_type","statement","scope_signals",
          "depth","competencies","verification_status"
        ],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^E[0-9]{3,}$"},
          "source_type": {"enum": ["resume","portfolio","public","document","user","other"]},
          "source_weight": {"type": "number", "minimum": 0, "maximum": 1},
          "statement": {"type": "string", "minLength": 1},
          "dates": {"type": "array", "items": {"type": "string"}},
          "metrics": {"type": "array", "items": {"type": "string"}},
          "scope_signals": {
            "type": "array",
            "items": {"enum": ["people","fiscal","portfolio","governance","change","executive","technical"]}
          },
          "depth": {"type": "string"},
          "competencies": {"type": "array", "items": {"type": "string"}},
          "verification_status": {"enum": ["unreviewed","self-attested","source-corroborated","verified"]},
          "reviewed": {
            "type": "object",
            "required": ["role_project","dates","source_reference","confidentiality","authority_scope","reviewer_note"],
            "properties": {
              "role_project": {"type": "string"},
              "dates": {"type": "string"},
              "source_reference": {"type": "string"},
              "confidentiality": {"enum": ["unspecified","public","private","anonymize","do-not-use"]},
              "authority_scope": {"type": "string"},
              "reviewer_note": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}