# Required paths inside the container / runtime
CCX_SNAPSHOT=/data/institution_program_product_snapshot.csv
CCX_MANIFEST=/data/institution_program_product_snapshot_manifest.json
CCX_MODEL_VERSION=MODEL_VERSION

# Optional evidence files
# CCX_CURRENT_LABOR=/data/current_labor.json
# CCX_PROJECTIONS=/data/projections.json
# CCX_CAREER_ATTRIBUTES=/data/career_preference_attributes.csv

# Omit this in non-production. In production it must be the exact record
# produced by service_activation_guard.py for the same snapshot/model identity.
# CCX_ACTIVATION_RECORD=/secrets/service_activation_record.json

# Comma-separated browser origins. Never use * with production authorization.
CCX_ALLOWED_ORIGINS=https://www.lauraelizabethhand.com
PORT=8080
