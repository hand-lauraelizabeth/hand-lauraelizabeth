{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "match_request.schema.json",
  "title": "College + Career Match Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_mode",
    "constraints",
    "preferences"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "decision_mode": {
      "enum": [
        "broad_exploration",
        "career_first",
        "college_program_first",
        "compare_known",
        "transfer",
        "returning_student"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint_id",
          "field",
          "operator",
          "value",
          "unknown_policy"
        ],
        "properties": {
          "constraint_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "eq",
              "neq",
              "in",
              "not_in",
              "gte",
              "gt",
              "lte",
              "lt"
            ]
          },
          "value": {},
          "unknown_policy": {
            "enum": [
              "keep_visible",
              "exclude_unknown"
            ]
          },
          "source_question_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "preference_id",
          "dimension",
          "importance",
          "priority_explicit"
        ],
        "properties": {
          "preference_id": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "enum": [
              "college_fit",
              "affordability",
              "academic_program_fit",
              "transfer_pathway_fit",
              "admissions_context",
              "career_pathway_fit",
              "current_labor_market",
              "long_term_outlook",
              "geographic_fit",
              "transit_access_fit",
              "walkability_fit",
              "housing_context_fit",
              "accessibility_evidence_fit"
            ]
          },
          "importance": {
            "type": "number",
            "minimum": 0
          },
          "priority_explicit": {
            "const": true
          },
          "source_question_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "career_preferences": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "preference_id",
          "attribute_id",
          "operator",
          "importance",
          "priority_explicit"
        ],
        "properties": {
          "preference_id": {
            "type": "string",
            "minLength": 1
          },
          "attribute_id": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "target_distance",
              "higher_preferred",
              "lower_preferred",
              "range",
              "categorical_match"
            ]
          },
          "importance": {
            "type": "number",
            "minimum": 0
          },
          "priority_explicit": {
            "const": true
          },
          "target_value": {},
          "target_min": {
            "type": [
              "number",
              "null"
            ]
          },
          "target_max": {
            "type": [
              "number",
              "null"
            ]
          },
          "scale_min": {
            "type": [
              "number",
              "null"
            ]
          },
          "scale_max": {
            "type": [
              "number",
              "null"
            ]
          },
          "source_question_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "school_location_semantics": {
          "enum": [
            "no_preference",
            "selected_places",
            "distance_from_home"
          ]
        },
        "selected_states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "home_geography_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "work_market_semantics": {
          "enum": [
            "school_local",
            "selected_market",
            "national",
            "remote_or_flexible",
            "unspecified"
          ]
        },
        "intended_work_market": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "market_id",
            "market_type"
          ],
          "properties": {
            "market_id": {
              "type": "string",
              "minLength": 1
            },
            "market_type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "transfer_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "source_institution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_system": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_course_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "target_program_required": {
          "type": "boolean"
        }
      }
    },
    "pinned_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "data_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
