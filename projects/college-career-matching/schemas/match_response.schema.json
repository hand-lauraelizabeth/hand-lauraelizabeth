{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "match_response.schema.json",
  "title": "College + Career Match Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "data_version",
    "model_version",
    "generated_at_utc",
    "result_count",
    "pagination",
    "warnings",
    "results",
    "ordering"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{20}$"
    },
    "data_version": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "result_count": {
      "type": "integer",
      "minimum": 0
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "page_size",
        "total_pages",
        "has_next",
        "has_previous"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "total_pages": {
          "type": "integer",
          "minimum": 0
        },
        "has_next": {
          "type": "boolean"
        },
        "has_previous": {
          "type": "boolean"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "candidate_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "institution",
          "program",
          "eligibility",
          "dimensions",
          "explanation",
          "career_pathways",
          "career_preference_alignment",
          "transfer",
          "labor_market",
          "evidence_coverage",
          "source_freshness",
          "recommendation"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "institution": {
            "type": "object",
            "required": [
              "unitid",
              "name",
              "city",
              "state"
            ],
            "properties": {
              "unitid": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "city": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "program": {
            "type": "object",
            "required": [
              "program_id",
              "name",
              "cip_code",
              "credential_level"
            ],
            "properties": {
              "program_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "cip_code": {
                "type": "string"
              },
              "credential_level": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "eligibility": {
            "type": "object",
            "required": [
              "status",
              "reason_codes"
            ],
            "properties": {
              "status": {
                "enum": [
                  "eligible",
                  "eligible_with_unknown",
                  "review"
                ]
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "dimension",
                "value",
                "coverage_rate",
                "evidence_state"
              ],
              "properties": {
                "dimension": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "coverage_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidence_state": {
                  "type": "string"
                }
              }
            }
          },
          "explanation": {
            "type": "object",
            "required": [
              "why_it_matches",
              "tradeoffs",
              "context",
              "unknowns"
            ],
            "properties": {
              "why_it_matches": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reason"
                }
              },
              "tradeoffs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reason"
                }
              },
              "unknowns": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reason"
                }
              },
              "context": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reason"
                }
              }
            }
          },
          "career_pathways": {
            "type": "object",
            "required": [
              "pathway_count",
              "soc_codes",
              "pathways",
              "representative_pathways"
            ],
            "properties": {
              "pathway_count": {
                "type": "integer",
                "minimum": 0
              },
              "soc_codes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "representative_pathways": {
                "type": "array"
              },
              "pathways": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "soc_code",
                    "occupation_title"
                  ],
                  "properties": {
                    "soc_code": {
                      "type": "string"
                    },
                    "occupation_title": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "transfer": {
            "type": [
              "object",
              "null"
            ]
          },
          "labor_market": {
            "$ref": "#/$defs/labor"
          },
          "evidence_coverage": {
            "type": "object",
            "required": [
              "overall_status",
              "review_flags"
            ],
            "properties": {
              "overall_status": {
                "enum": [
                  "broad",
                  "partial",
                  "limited"
                ]
              },
              "review_flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "source_freshness": {
            "type": "array"
          },
          "recommendation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "rank",
              "baseline_score",
              "review_eligibility",
              "production_authorized"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_ranked",
                  "review_eligible_ranked",
                  "eligible_unranked"
                ]
              },
              "rank": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "baseline_score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "review_eligibility": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "eligible_for_review",
                  null
                ]
              },
              "production_authorized": {
                "type": "boolean"
              }
            }
          },
          "career_preference_alignment": {
            "$ref": "#/$defs/careerPreferenceAlignment"
          }
        }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "ranking_context_id",
        "review_eligible_ranked_count",
        "unranked_eligible_count",
        "production_authorized"
      ],
      "properties": {
        "mode": {
          "enum": [
            "deterministic_unranked",
            "review_eligible_ranking"
          ]
        },
        "ranking_context_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^rankctx_[0-9a-f]{24}$"
        },
        "review_eligible_ranked_count": {
          "type": "integer",
          "minimum": 0
        },
        "unranked_eligible_count": {
          "type": "integer",
          "minimum": 0
        },
        "production_authorized": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "reason": {
      "type": "object",
      "required": [
        "code",
        "text",
        "evidence_ids",
        "supporting_evidence"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/explanationEvidence"
          }
        }
      }
    },
    "labor": {
      "type": "object",
      "required": [
        "selected_work_market",
        "long_term_outlook"
      ],
      "properties": {
        "selected_work_market": {
          "type": "object",
          "required": [
            "evidence_state"
          ],
          "properties": {
            "market_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "market_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_state": {
              "enum": [
                "observed",
                "not_requested",
                "unavailable"
              ]
            },
            "soc_evidence": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "market_label": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "long_term_outlook": {
          "type": "object",
          "required": [
            "evidence_state"
          ],
          "properties": {
            "evidence_state": {
              "enum": [
                "observed",
                "unavailable"
              ]
            },
            "soc_evidence": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "semantic_note": {
          "type": "string"
        }
      }
    },
    "explanationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_family",
        "soc_code",
        "occupation_title",
        "geography",
        "source_vintage",
        "evidence_state",
        "measures",
        "measure_states"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_family": {
          "enum": [
            "current_labor_market",
            "long_term_outlook"
          ]
        },
        "soc_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "occupation_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "geography": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "market_id",
            "market_type",
            "market_label",
            "projection_geography",
            "work_market_semantics"
          ],
          "properties": {
            "market_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "market_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "market_label": {
              "type": [
                "string",
                "null"
              ]
            },
            "projection_geography": {
              "type": [
                "string",
                "null"
              ]
            },
            "work_market_semantics": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "source_vintage": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_state": {
          "type": "string"
        },
        "measures": {
          "type": "object"
        },
        "measure_states": {
          "type": "object"
        }
      }
    },
    "careerPreferenceAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "explicit_preference_count",
        "pathway_count",
        "observed_pathway_count",
        "pathway_coverage_rate",
        "score_summary",
        "pathways",
        "semantic_note"
      ],
      "properties": {
        "status": {
          "enum": [
            "no_explicit_preferences",
            "observed",
            "insufficient_attribute_evidence"
          ]
        },
        "explicit_preference_count": {
          "type": "integer",
          "minimum": 0
        },
        "pathway_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_pathway_count": {
          "type": "integer",
          "minimum": 0
        },
        "pathway_coverage_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "score_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "median",
            "min",
            "max"
          ],
          "properties": {
            "median": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "min": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "max": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "pathways": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "soc_code",
              "alignment_score",
              "observed_preference_count",
              "explicit_preference_count",
              "coverage_rate",
              "preferences"
            ],
            "properties": {
              "soc_code": {
                "type": "string"
              },
              "alignment_score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "observed_preference_count": {
                "type": "integer",
                "minimum": 0
              },
              "explicit_preference_count": {
                "type": "integer",
                "minimum": 0
              },
              "coverage_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "preferences": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "preference_id",
                    "attribute_id",
                    "attribute_value",
                    "alignment",
                    "importance",
                    "evidence_state",
                    "element_id",
                    "element_name",
                    "scale_id",
                    "source_release",
                    "source_vintage"
                  ],
                  "properties": {
                    "preference_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "attribute_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "attribute_value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "alignment": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "importance": {
                      "type": "number",
                      "minimum": 0
                    },
                    "evidence_state": {
                      "type": "string"
                    },
                    "element_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "element_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "scale_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "source_release": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "source_vintage": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "semantic_note": {
          "type": "string"
        }
      }
    }
  }
}
