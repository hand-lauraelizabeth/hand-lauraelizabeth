{
  "schema_version": "1.0",
  "questionnaire_version": "2026-10-06.2",
  "principles": {
    "skippable_preferences": true,
    "no_default_priority_weights": true,
    "unknown_is_not_mismatch": true,
    "school_location_separate_from_work_market": true,
    "hard_constraints_require_explicit_confirmation": true
  },
  "questions": [
    {
      "question_id": "decision_mode",
      "section": "start",
      "prompt": "What are you trying to figure out?",
      "control": "single_select",
      "required": true,
      "options": [
        {
          "value": "broad_exploration",
          "label": "Explore colleges, programs, and careers together"
        },
        {
          "value": "career_first",
          "label": "Start with careers that may fit me"
        },
        {
          "value": "college_program_first",
          "label": "Find colleges for a program or field I already have in mind"
        },
        {
          "value": "compare_known",
          "label": "Compare colleges or programs I already know"
        },
        {
          "value": "transfer",
          "label": "Plan a transfer"
        },
        {
          "value": "returning_student",
          "label": "Return to college or finish a degree"
        }
      ],
      "mapping": {
        "target": "decision_mode"
      }
    },
    {
      "question_id": "academic_fields",
      "section": "must_haves",
      "prompt": "Are there academic fields you specifically want the program to be classified in?",
      "help": "Choices come from the active program snapshot's authoritative CIP classifications. Leave blank to explore across fields.",
      "control": "searchable_multi_select",
      "required": false,
      "option_source": "options.cip_fields",
      "mapping": {
        "target": "constraint",
        "field": "cip_code",
        "operator": "in",
        "unknown_policy": "keep_visible"
      }
    },
    {
      "question_id": "school_states",
      "section": "must_haves",
      "prompt": "Are there states where you need your school to be located?",
      "help": "Leave this blank if location is a preference rather than a requirement.",
      "control": "state_multi_select",
      "required": false,
      "option_source": "options.states",
      "mapping": {
        "target": "constraint",
        "field": "state",
        "operator": "in",
        "unknown_policy": "keep_visible"
      }
    },
    {
      "question_id": "credential_levels",
      "section": "must_haves",
      "prompt": "Are you looking for particular credential or degree levels?",
      "control": "credential_multi_select",
      "required": false,
      "option_source": "options.credential_levels",
      "mapping": {
        "target": "constraint",
        "field": "credential_level",
        "operator": "in",
        "unknown_policy": "keep_visible"
      }
    },
    {
      "question_id": "online_requirement",
      "section": "must_haves",
      "prompt": "Do you need a program you can complete online?",
      "control": "single_select",
      "required": false,
      "options": [
        {
          "value": "required",
          "label": "Yes, online availability is required"
        },
        {
          "value": "not_required",
          "label": "No, it is not required"
        }
      ],
      "mapping": {
        "target": "conditional_constraint",
        "when_value": "required",
        "field": "online_available",
        "operator": "eq",
        "value": true,
        "unknown_policy": "keep_visible"
      }
    },
    {
      "question_id": "campus_settings",
      "section": "must_haves",
      "prompt": "Do you need a particular campus setting?",
      "help": "Uses the NCES locale classification: City, Suburban, Town, or Rural. Leave blank if setting is only a preference.",
      "control": "multi_select",
      "required": false,
      "option_source": "options.campus_settings",
      "mapping": {
        "target": "constraint",
        "field": "campus__locale_category",
        "operator": "in",
        "unknown_policy": "keep_visible"
      }
    },
    {
      "question_id": "housing_requirement",
      "section": "must_haves",
      "prompt": "Do you have a firm housing requirement?",
      "help": "Housing availability and universal first-year/full-time residency requirements are evaluated separately. Roommate versus private-room availability requires school-specific evidence and is not inferred here.",
      "control": "single_select",
      "required": false,
      "options": [
        {
          "value": "available",
          "label": "Institutionally controlled housing must be available"
        },
        {
          "value": "choice",
          "label": "Housing must be available, but not universally required for full-time first-time students"
        },
        {
          "value": "commuter",
          "label": "I need a school without institutionally controlled housing"
        }
      ],
      "mapping": {
        "target": "housing_constraint_bundle",
        "rules": {
          "available": [
            {
              "field": "campus__housing_available",
              "operator": "eq",
              "value": true,
              "unknown_policy": "keep_visible"
            }
          ],
          "choice": [
            {
              "field": "campus__housing_available",
              "operator": "eq",
              "value": true,
              "unknown_policy": "keep_visible"
            },
            {
              "field": "campus__housing_required_all_ftft",
              "operator": "eq",
              "value": false,
              "unknown_policy": "keep_visible"
            }
          ],
          "commuter": [
            {
              "field": "campus__housing_available",
              "operator": "eq",
              "value": false,
              "unknown_policy": "keep_visible"
            }
          ]
        }
      }
    },
    {
      "question_id": "net_price_income_band",
      "section": "must_haves",
      "prompt": "Which published household-income band should the net-price comparison use?",
      "help": "These are institutional average net prices after grants/scholarships, not personalized aid estimates. Household size is not used to invent a more specific estimate.",
      "control": "single_select",
      "required": false,
      "options": [
        {
          "value": "overall",
          "label": "Overall average"
        },
        {
          "value": "0_30",
          "label": "$0–30,000"
        },
        {
          "value": "30_48",
          "label": "$30,001–48,000"
        },
        {
          "value": "48_75",
          "label": "$48,001–75,000"
        },
        {
          "value": "75_110",
          "label": "$75,001–110,000"
        },
        {
          "value": "110_plus",
          "label": "$110,001+"
        }
      ],
      "mapping": {
        "target": "selector_only"
      }
    },
    {
      "question_id": "net_price_ceiling",
      "section": "must_haves",
      "prompt": "Do you have a firm maximum annual average net price?",
      "help": "Average net price is cost of attendance after grant and scholarship aid under the published source definition. It is not tuition, sticker price, or a personalized aid estimate.",
      "control": "currency_optional",
      "required": false,
      "mapping": {
        "target": "income_band_net_price_constraint",
        "selector_question_id": "net_price_income_band",
        "default_selector": "overall",
        "field_by_selector": {
          "overall": "finance__net_price_overall",
          "0_30": "finance__net_price_income_0_30",
          "30_48": "finance__net_price_income_30_48",
          "48_75": "finance__net_price_income_48_75",
          "75_110": "finance__net_price_income_75_110",
          "110_plus": "finance__net_price_income_110_plus"
        },
        "operator": "lte",
        "unknown_policy": "keep_visible"
      }
    },
    {
      "question_id": "institutional_aid_required",
      "section": "must_haves",
      "prompt": "Do you require published evidence of institutional grant or scholarship aid?",
      "control": "single_select",
      "required": false,
      "options": [
        {
          "value": "required",
          "label": "Yes, require published institutional-aid evidence"
        },
        {
          "value": "not_required",
          "label": "No"
        }
      ],
      "mapping": {
        "target": "conditional_constraint",
        "when_value": "required",
        "field": "finance__institutional_grant_evidence",
        "operator": "eq",
        "value": true,
        "unknown_policy": "keep_visible"
      }
    },
    {
      "question_id": "work_study_required",
      "section": "must_haves",
      "prompt": "Do you require published Federal Work-Study participation evidence?",
      "control": "single_select",
      "required": false,
      "options": [
        {
          "value": "required",
          "label": "Yes, require published Work-Study evidence"
        },
        {
          "value": "not_required",
          "label": "No"
        }
      ],
      "mapping": {
        "target": "conditional_constraint",
        "when_value": "required",
        "field": "finance__work_study_evidence",
        "operator": "eq",
        "value": true,
        "unknown_policy": "keep_visible"
      }
    },
    {
      "question_id": "state_local_aid_required",
      "section": "must_haves",
      "prompt": "Do you require published state/local grant-aid evidence?",
      "control": "single_select",
      "required": false,
      "options": [
        {
          "value": "required",
          "label": "Yes, require published state/local aid evidence"
        },
        {
          "value": "not_required",
          "label": "No"
        }
      ],
      "mapping": {
        "target": "conditional_constraint",
        "when_value": "required",
        "field": "finance__state_local_grant_evidence",
        "operator": "eq",
        "value": true,
        "unknown_policy": "keep_visible"
      }
    },
    {
      "question_id": "disability_services_evidence_required",
      "section": "must_haves",
      "prompt": "Do you require documented disability-services reporting evidence?",
      "help": "This indicates documented disability-services evidence only. It is not a rating of service quality or physical campus accessibility.",
      "control": "single_select",
      "required": false,
      "options": [
        {
          "value": "required",
          "label": "Yes, require documented disability-services evidence"
        },
        {
          "value": "not_required",
          "label": "No"
        }
      ],
      "mapping": {
        "target": "conditional_constraint",
        "when_value": "required",
        "field": "campus__disability_services_evidence_available",
        "operator": "eq",
        "value": true,
        "unknown_policy": "keep_visible"
      }
    },
    {
      "question_id": "affordability_priority",
      "section": "priorities",
      "prompt": "How important is keeping college costs low?",
      "control": "importance_optional",
      "required": false,
      "mapping": {
        "target": "preference",
        "dimension": "affordability"
      }
    },
    {
      "question_id": "transit_access_priority",
      "section": "priorities",
      "prompt": "How important is convenient public-transit access near the school?",
      "help": "Transit proximity is treated separately from route/station accessibility and does not by itself establish an accessible path or vehicle.",
      "control": "importance_optional",
      "required": false,
      "mapping": {
        "target": "preference",
        "dimension": "transit_access_fit"
      }
    },
    {
      "question_id": "walkability_priority",
      "section": "priorities",
      "prompt": "How important is a more walkable area for everyday needs?",
      "help": "Walkability/location-efficiency evidence is vintage-labeled and remains separate from physical-accessibility evidence.",
      "control": "importance_optional",
      "required": false,
      "mapping": {
        "target": "preference",
        "dimension": "walkability_fit"
      }
    },
    {
      "question_id": "housing_choice_priority",
      "section": "priorities",
      "prompt": "How important is having institutionally controlled housing without a universal full-time first-time residency requirement?",
      "help": "This preference is about housing choice. Roommate or private-room configuration requires separate school-specific evidence.",
      "control": "importance_optional",
      "required": false,
      "mapping": {
        "target": "preference",
        "dimension": "housing_context_fit"
      }
    },
    {
      "question_id": "disability_services_priority",
      "section": "priorities",
      "prompt": "How important is having documented disability-services information available?",
      "help": "This preference concerns documentation/evidence availability only. It is not a score of service quality or physical campus accessibility.",
      "control": "importance_optional",
      "required": false,
      "mapping": {
        "target": "preference",
        "dimension": "accessibility_evidence_fit"
      }
    },
    {
      "question_id": "academic_program_priority",
      "section": "priorities",
      "prompt": "How important is the strength and fit of the specific program?",
      "control": "importance_optional",
      "required": false,
      "mapping": {
        "target": "preference",
        "dimension": "academic_program_fit"
      }
    },
    {
      "question_id": "career_pathway_priority",
      "section": "priorities",
      "prompt": "How important is having several plausible career pathways from the program?",
      "control": "importance_optional",
      "required": false,
      "mapping": {
        "target": "preference",
        "dimension": "career_pathway_fit"
      }
    },
    {
      "question_id": "current_labor_market_priority",
      "section": "priorities",
      "prompt": "How important is current labor-market context in the market you selected?",
      "help": "Current employment and wage evidence is kept separate from long-term occupational projections. Missing or suppressed local evidence is not treated as zero.",
      "control": "importance_optional",
      "required": false,
      "visible_for_modes": [
        "career_first"
      ],
      "mapping": {
        "target": "preference",
        "dimension": "current_labor_market"
      }
    },
    {
      "question_id": "long_term_outlook_priority",
      "section": "priorities",
      "prompt": "How important is long-term occupational outlook?",
      "help": "Long-term BLS projection evidence is a separate horizon from current local employment and wage evidence.",
      "control": "importance_optional",
      "required": false,
      "visible_for_modes": [
        "career_first"
      ],
      "mapping": {
        "target": "preference",
        "dimension": "long_term_outlook"
      }
    },
    {
      "question_id": "transfer_priority",
      "section": "priorities",
      "prompt": "How important is preserving as much of your prior coursework as possible?",
      "control": "importance_optional",
      "required": false,
      "visible_for_modes": [
        "transfer",
        "returning_student"
      ],
      "mapping": {
        "target": "preference",
        "dimension": "transfer_pathway_fit"
      }
    },
    {
      "question_id": "work_market_semantics",
      "section": "career_and_place",
      "prompt": "Where would you most want career-market information to describe?",
      "control": "single_select",
      "required": false,
      "options": [
        {
          "value": "school_local",
          "label": "The area around each school"
        },
        {
          "value": "selected_market",
          "label": "Another area I choose"
        },
        {
          "value": "national",
          "label": "National information"
        },
        {
          "value": "remote_or_flexible",
          "label": "I am flexible or interested in remote work"
        },
        {
          "value": "unspecified",
          "label": "I am not sure yet"
        }
      ],
      "mapping": {
        "target": "geography.work_market_semantics"
      }
    },
    {
      "question_id": "work_market",
      "section": "career_and_place",
      "prompt": "Which labor market should current career information describe?",
      "control": "labor_market_lookup",
      "required": false,
      "visible_when": {
        "question_id": "work_market_semantics",
        "value": "selected_market"
      },
      "mapping": {
        "target": "geography.intended_work_market"
      },
      "option_source": "options.labor_markets"
    },
    {
      "question_id": "career_analysis",
      "section": "career_and_place",
      "prompt": "Would you like analyzing data or information to be an important part of your work?",
      "control": "importance_optional",
      "required": false,
      "mapping": {
        "target": "career_preference",
        "attribute_id": "onet31:work_activity:4.A.2.a.4:IM",
        "operator": "higher_preferred",
        "scale_min": 1,
        "scale_max": 5
      },
      "help": "Mapped to O*NET 31.0 Work Activity 4.A.2.a.4 (Analyzing Data or Information), Importance scale. This is separate from problem solving.",
      "visible_for_modes": [
        "career_first"
      ]
    },
    {
      "question_id": "career_problem_solving",
      "section": "career_and_place",
      "prompt": "Would you like making decisions and solving problems to be an important part of your work?",
      "help": "Mapped to O*NET 31.0 Work Activity 4.A.2.b.1 (Making Decisions and Solving Problems), Importance scale.",
      "control": "importance_optional",
      "required": false,
      "visible_for_modes": [
        "career_first"
      ],
      "mapping": {
        "target": "career_preference",
        "attribute_id": "onet31:work_activity:4.A.2.b.1:IM",
        "operator": "higher_preferred",
        "scale_min": 1,
        "scale_max": 5
      }
    },
    {
      "question_id": "career_creativity",
      "section": "career_and_place",
      "prompt": "Would you like thinking creatively to be an important part of your work?",
      "control": "importance_optional",
      "required": false,
      "mapping": {
        "target": "career_preference",
        "attribute_id": "onet31:work_activity:4.A.2.b.2:IM",
        "operator": "higher_preferred",
        "scale_min": 1,
        "scale_max": 5
      },
      "help": "Mapped to O*NET 31.0 Work Activity 4.A.2.b.2 (Thinking Creatively), Importance scale. It is not inferred from the Originality ability or Innovation work style.",
      "visible_for_modes": [
        "career_first"
      ]
    },
    {
      "question_id": "transfer_source",
      "section": "transfer",
      "prompt": "Where are you transferring from?",
      "control": "institution_lookup",
      "required": false,
      "visible_for_modes": [
        "transfer",
        "returning_student"
      ],
      "mapping": {
        "target": "transfer_context.source_institution_id"
      }
    }
  ]
}
